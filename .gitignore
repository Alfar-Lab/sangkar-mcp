# Reference implementations — cloned for analysis only, not vendored.
# Re-create with:
#   git clone https://github.com/DeusData/codebase-memory-mcp
#   git clone https://github.com/tirth8205/code-review-graph
codebase-memory-mcp/
code-review-graph/

# Installed dependencies and build output
node_modules/
dist/

# The npm platform package's binary: `rust/scripts/package.sh` fills it, the layout is committed
/npm/*/bin/sangkar

# The graph store; it carries its own .gitignore holding a single `*`
.sangkar/
# Pre-rename store, kept only until the first `sangkar index`
.codegraph/
*.db
*.db-wal
*.db-shm

# Local editor / OS noise
.DS_Store
*.swp
