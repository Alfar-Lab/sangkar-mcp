{
  "name": "sangkar-mcp",
  "version": "0.4.0-beta.1",
  "description": "Read-only MCP server and CLI over one repository's call graph, backed by SQLite.",
  "license": "MIT",
  "author": "Aldi Fahluzi",
  "type": "module",
  "bin": {
    "sangkar": "bin/sangkar.ts"
  },
  "files": [
    "bin",
    "src",
    "agent",
    "README.md"
  ],
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-graph",
    "call-graph",
    "tree-sitter",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alfar-Lab/sangkar-mcp.git"
  },
  "homepage": "https://github.com/Alfar-Lab/sangkar-mcp#readme",
  "bugs": {
    "url": "https://github.com/Alfar-Lab/sangkar-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "mcp": "bun run bin/sangkar.ts",
    "index": "bun run bin/sangkar.ts index",
    "status": "bun run bin/sangkar.ts status",
    "dev": "bun --watch run bin/sangkar.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests bin",
    "build": "bun build --compile bin/sangkar.ts --asset src/shared/store/migrations --outfile dist/sangkar",
    "db:generate": "drizzle-kit generate",
    "db:drift": "drizzle-kit generate --name drift-check && git diff --exit-code src/shared/store/migrations",
    "db:parity": "bun test tests/schema-parity.test.ts",
    "acceptance": "bun test tests/acceptance.test.ts",
    "release:beta": "npm publish --tag beta"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "drizzle-orm": "0.45.4",
    "web-tree-sitter": "0.27.2",
    "tree-sitter-wasms": "0.1.13"
  },
  "devDependencies": {
    "typescript": "^5.9",
    "@types/bun": "latest",
    "@biomejs/biome": "^2",
    "drizzle-kit": "0.31.11"
  }
}
