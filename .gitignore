# Reference implementations — cloned for analysis only, not vendored.
# Re-create with:
#   git clone https://github.com/DeusData/codebase-memory-mcp
#   git clone https://github.com/tirth8205/code-review-graph
codebase-memory-mcp/
code-review-graph/

# Installed dependencies and build output. `dist/` is where the release workflow assembles the
# tarballs. `rust/.gitignore` already holds `/target`; repeated here so the 12 GB cargo directory
# stays out of the index even if that file is ever replaced.
node_modules/
dist/
/rust/target/

# The graph store; it carries its own .gitignore holding a single `*`
.sangkar/
# Pre-rename store, kept only until the first `sangkar index`
.codegraph/
*.db
*.db-wal
*.db-shm

# Local editor / OS noise
.DS_Store
*.swp
